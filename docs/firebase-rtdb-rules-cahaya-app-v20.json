{
  "rules": {
    ".read": true,
    ".write": true,
    "cahaya_access": {
      ".read": false,
      ".write": false,
      "users": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      },
      "wali": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      }
    },
    "cahaya_chat_v2": {
      ".read": false,
      ".write": false,
      "rooms": {
        "$roomId": {
          ".read": "auth != null && data.child('members').child(auth.uid).child('active').val() === true",
          "members": { ".write": false },
          "studentKey": { ".write": false },
          "studentName": { ".write": false },
          "lastMessage": { ".write": false },
          "updatedAt": { ".write": false },
          "messages": {
            "$messageId": {
              ".write": "auth != null && !data.exists() && root.child('cahaya_chat_v2/rooms').child($roomId).child('members').child(auth.uid).child('active').val() === true && newData.child('senderUid').val() === auth.uid",
              ".validate": "newData.hasOnly(['text','senderUid','senderDisplay','createdAt']) && newData.hasChildren(['text','senderUid','senderDisplay','createdAt']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 4000 && newData.child('senderDisplay').val() === root.child('cahaya_chat_v2/rooms').child($roomId).child('members').child(auth.uid).child('label').val() && newData.child('createdAt').isNumber() && newData.child('createdAt').val() <= now + 60000 && newData.child('createdAt').val() >= now - 300000"
            }
          },
          "receipts": {
            "$uid": {
              ".read": "auth != null && root.child('cahaya_chat_v2/rooms').child($roomId).child('members').child(auth.uid).child('active').val() === true",
              ".write": "auth != null && auth.uid === $uid && root.child('cahaya_chat_v2/rooms').child($roomId).child('members').child(auth.uid).child('active').val() === true",
              ".validate": "newData.hasOnly(['lastReadAt']) && newData.child('lastReadAt').isNumber()"
            }
          }
        }
      },
      "user_rooms": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".indexOn": ["updatedAt"],
          "$roomId": {
            "lastReadAt": {
              ".write": "auth != null && auth.uid === $uid && root.child('cahaya_chat_v2/rooms').child($roomId).child('members').child(auth.uid).child('active').val() === true",
              ".validate": "newData.isNumber()"
            }
          }
        }
      }
    },
    "cahaya_app": {
      ".read": "auth != null && root.child('cahaya_access/users').child(auth.uid).child('active').val() === true && root.child('cahaya_access/users').child(auth.uid).child('internal').val() === true",
      ".write": "auth != null && root.child('cahaya_access/users').child(auth.uid).child('active').val() === true && root.child('cahaya_access/users').child(auth.uid).child('internal').val() === true",
      "face_attendance_poc": {
        ".read": false,
        ".write": false
      },
      "master_usrah": {
        ".read": "auth != null && root.child('cahaya_access/wali').child(auth.uid).child('active').val() === true"
      },
      "master_akademik": {
        ".read": "auth != null && root.child('cahaya_access/wali').child(auth.uid).child('active').val() === true"
      },
      "pengaturan_media": {
        ".read": "auth != null && root.child('cahaya_access/wali').child(auth.uid).child('active').val() === true"
      },
      "jadwal_program_harian": {
        ".read": "auth != null && root.child('cahaya_access/wali').child(auth.uid).child('active').val() === true"
      },
      "jadwal_piket_naqib": {
        ".read": "auth != null && root.child('cahaya_access/wali').child(auth.uid).child('active').val() === true"
      },
      "kalender_pendidikan": {
        ".read": "auth != null && root.child('cahaya_access/wali').child(auth.uid).child('active').val() === true"
      },
      "direktori_chat_wali": {
        ".read": "auth != null && root.child('cahaya_access/wali').child(auth.uid).child('active').val() === true",
        ".write": false
      },
      "absensi_program_harian": {
        ".indexOn": [
          "tanggal"
        ]
      },
      "absensi_pembelajaran": {
        ".indexOn": [
          "tanggal"
        ]
      },
      "log_absensi_guru": {
        ".indexOn": [
          "tanggal"
        ]
      },
      "setoran_tahfiz": {
        ".indexOn": [
          "tanggal"
        ]
      },
      "nilai_ujian_bulanan": {
        ".indexOn": [
          "tanggal_ujian",
          "periode_ujian",
          "jenis_ujian",
          "tahun_akademik",
          "nama_santri",
          "guru_penguji",
          "mata_pelajaran"
        ]
      },
      "nilai_ujian": {
        ".indexOn": [
          "tanggal",
          "periode_ujian",
          "jenis_ujian",
          "tahun_akademik",
          "nama_santri",
          "guru_penguji",
          "mata_pelajaran"
        ]
      },
      "asesmen_cahaya_santri": {
        ".indexOn": [
          "tanggalAsesmen"
        ]
      },
      "log_lapor_inisiatif": {
        ".indexOn": [
          "tanggal",
          "caseV2/higherEscalation/requestedAt",
          "caseV2/higherEscalation/response/respondedAt"
        ]
      },
      "poin_manual": {
        ".indexOn": [
          "tanggal"
        ]
      },
      "laporan_penindakan": {
        ".indexOn": [
          "tanggalPenindakan"
        ]
      },
      "pemeriksaan_kesehatan": {
        ".indexOn": [
          "tanggalPemeriksaan"
        ]
      },
      "perizinan_santri": {
        ".indexOn": [
          "tanggalPengajuan"
        ]
      },
      "perizinan_ringkas": {
        ".indexOn": [
          "tanggalPengajuan",
          "status",
          "sumberPengajuan"
        ]
      },
      "jurnal_piket_naqib": {
        ".indexOn": [
          "tanggal"
        ]
      },
      "jurnal_kesehatan": {
        ".indexOn": [
          "tanggal"
        ]
      },
      "jurnal_sarpras": {
        ".indexOn": [
          "tanggal"
        ]
      },
      "jurnal_sarpras_harian": {
        ".indexOn": [
          "tanggal"
        ]
      },
      "jurnal_keamanan_kebersihan": {
        ".indexOn": [
          "tanggal"
        ]
      },
      "checklist_harian_sarpras": {
        ".indexOn": [
          "tanggal"
        ]
      },
      "tindak_lanjut_sarpras": {
        ".indexOn": [
          "tanggalTindakan",
          "status"
        ]
      },
      "tindak_lanjut_sdm": {
        ".indexOn": [
          "tanggal",
          "namaSDM"
        ]
      },
      "keuangan": {
        "transaksi_kantin": {
          ".indexOn": [
            "studentKey",
            "tanggal",
            "jenisKelamin"
          ]
        },
        "pembayaran": {
          ".indexOn": [
            "studentKey",
            "tanggal",
            "waktu",
            "jenisKelamin"
          ]
        },
        "rekening_santri": {
          ".indexOn": [
            "kelas",
            "jenisKelamin"
          ]
        },
        "tagihan": {
          ".indexOn": [
            "studentKey",
            "tanggal",
            "periode",
            "status",
            "jenisKelamin"
          ]
        },
        "mutasi": {
          ".indexOn": [
            "studentKey",
            "tanggal",
            "waktu",
            "kategori",
            "jenisKelamin"
          ]
        },
        "kantin": {
          "putra": {
            "transaksi": {
              ".indexOn": [
                "studentKey",
                "tanggal",
                "waktu",
                "status",
                "jenisKelamin",
                "unitKantin"
              ]
            }
          },
          "putri": {
            "transaksi": {
              ".indexOn": [
                "studentKey",
                "tanggal",
                "waktu",
                "status",
                "jenisKelamin",
                "unitKantin"
              ]
            }
          }
        },
        "audit": {
          ".indexOn": [
            "tanggal",
            "waktu",
            "action"
          ]
        }
      },
      "wali_index": {
        "$santriKey": {
          ".read": "auth != null && root.child('cahaya_access/wali').child(auth.uid).child('active').val() === true && root.child('cahaya_access/wali').child(auth.uid).child('students').child($santriKey).child('active').val() === true",
          ".write": false,
          "program": {
            ".indexOn": [
              "tanggal"
            ]
          },
          "pembelajaran": {
            ".indexOn": [
              "tanggal"
            ]
          },
          "tahfiz": {
            ".indexOn": [
              "tanggal"
            ]
          },
          "nilai_bulanan": {
            ".indexOn": [
              "tanggal_ujian"
            ]
          },
          "nilai_akademik": {
            ".indexOn": [
              "tanggal_ujian",
              "jenis_ujian",
              "periode_ujian",
              "tahun_akademik",
              "status_nilai"
            ]
          },
          "asesmen": {
            ".indexOn": [
              "tanggalAsesmen"
            ]
          },
          "laporan": {
            ".indexOn": [
              "tanggal"
            ]
          },
          "poin_manual": {
            ".indexOn": [
              "tanggal"
            ]
          },
          "penindakan": {
            ".indexOn": [
              "tanggalPenindakan"
            ]
          },
          "kesehatan": {
            ".indexOn": [
              "tanggalPemeriksaan"
            ]
          },
          "perizinan": {
            ".indexOn": [
              "tanggalPengajuan"
            ]
          },
          "halqah": {
            ".indexOn": [
              "tanggal"
            ]
          },
          "evaluasi_bulanan": {
            ".indexOn": [
              "tahun",
              "bulan",
              "approvedAt",
              "updatedAt"
            ]
          },
          "mentoring": {
            ".indexOn": [
              "tanggal",
              "updatedAt"
            ]
          }
        }
      },
      "evaluasi_bulanan_naqib": {
        ".indexOn": [
          "namaSantri",
          "tahun",
          "bulan",
          "status",
          "updatedAt"
        ]
      },
      "jadwal_pelajaran": {
        ".indexOn": [
          "kelas",
          "hari"
        ]
      },
      "absensi_halqah": {
        ".indexOn": [
          "tanggal"
        ]
      },
      "manajemen_operasional_v1": {
        "tasks": {
          ".indexOn": [
            "status",
            "deadline",
            "division",
            "pic",
            "assignedBy"
          ]
        },
        "observations": {
          ".indexOn": [
            "date",
            "signal",
            "division",
            "observer",
            "observedPerson"
          ]
        },
        "meetings": {
          ".indexOn": [
            "date",
            "meetingType",
            "purpose",
            "division"
          ]
        },
        "followups": {
          ".indexOn": [
            "status",
            "deadline",
            "sourceType",
            "division",
            "pic"
          ]
        },
        "reports": {
          ".indexOn": [
            "period",
            "division",
            "author",
            "authorLevel"
          ]
        },
        "journals": {
          ".indexOn": [
            "date",
            "username",
            "division",
            "level"
          ]
        },
        "competencies": {
          ".indexOn": [
            "status",
            "targetDate",
            "person",
            "coach",
            "division"
          ]
        }
      },
      "guru_berhalangan": {
        ".indexOn": [
          "tanggal",
          "guruTerjadwal",
          "guruPengganti",
          "statusKetidakhadiran"
        ]
      },
      "masalah_pendidikan": {
        ".indexOn": [
          "tanggal",
          "unit",
          "status",
          "kategori",
          "supervisorEscalation/directorEscalation/requestedAt",
          "supervisorEscalation/directorEscalation/response/respondedAt"
        ]
      },
      "masalah_pembinaan_karakter": {
        ".indexOn": [
          "supervisorEscalation/directorEscalation/requestedAt",
          "supervisorEscalation/directorEscalation/response/respondedAt"
        ]
      },
      "temuan_supervisor": {
        ".indexOn": [
          "directorEscalation/requestedAt",
          "directorEscalation/response/respondedAt"
        ]
      },
      "arah_target_direktur": {
        ".indexOn": [
          "deadline"
        ]
      },
      "perubahan_sistem_direktur": {
        ".indexOn": [
          "reviewDate"
        ]
      },
      "pembinaan_direktur_supervisor": {
        ".indexOn": [
          "reviewDate"
        ]
      },
      "kontrol_kelas": {
        ".indexOn": [
          "tanggal",
          "unit",
          "kelas",
          "status"
        ]
      },
      "tindak_lanjut_akademik": {
        ".indexOn": [
          "periode",
          "tanggal",
          "namaSantri",
          "mapel",
          "status"
        ]
      },
      "keputusan_direktur_pendidikan": {
        ".indexOn": [
          "periode",
          "tanggal",
          "unit",
          "status"
        ]
      },
      "target_pertumbuhan": {
        ".indexOn": [
          "namaSantri",
          "studentName",
          "status",
          "tanggalMulai",
          "timestamp"
        ]
      },
      "mentoring_usrah": {
        ".indexOn": [
          "periodePekan",
          "tanggal",
          "usrah",
          "asistenNaqib",
          "status"
        ]
      },
      "review_pembinaan_bulanan": {
        ".indexOn": [
          "periode",
          "unit",
          "supervisor",
          "timestamp"
        ]
      },
      "absensi_ibadah_guru": {
        ".indexOn": [
          "tanggal",
          "guruKey",
          "guruKode",
          "unit"
        ]
      },
      "pengaturan_guru_mukim": {
        ".indexOn": [
          "guruKey",
          "guruKode",
          "mukim",
          "aktif",
          "unit"
        ]
      }
    },
    "observasi_lapangan": {
      ".read": "auth != null && root.child('cahaya_access/users').child(auth.uid).child('active').val() === true && root.child('cahaya_access/users').child(auth.uid).child('internal').val() === true",
      ".write": "auth != null && root.child('cahaya_access/users').child(auth.uid).child('active').val() === true && root.child('cahaya_access/users').child(auth.uid).child('internal').val() === true",
      ".indexOn": [
        "tanggal",
        "jenis"
      ]
    },
    "observasi_lapangan_foto": {
      ".read": "auth != null && root.child('cahaya_access/users').child(auth.uid).child('active').val() === true && root.child('cahaya_access/users').child(auth.uid).child('internal').val() === true",
      ".write": "auth != null && root.child('cahaya_access/users').child(auth.uid).child('active').val() === true && root.child('cahaya_access/users').child(auth.uid).child('internal').val() === true"
    },
    "kalender_pendidikan": {
      ".read": "auth != null && (root.child('cahaya_access/users').child(auth.uid).child('active').val() === true || root.child('cahaya_access/wali').child(auth.uid).child('active').val() === true)",
      ".write": "auth != null && root.child('cahaya_access/users').child(auth.uid).child('active').val() === true && root.child('cahaya_access/users').child(auth.uid).child('internal').val() === true"
    },
    "kalender_materi_pembelajaran": {
      ".read": "auth != null && root.child('cahaya_access/users').child(auth.uid).child('active').val() === true && root.child('cahaya_access/users').child(auth.uid).child('internal').val() === true",
      ".write": "auth != null && root.child('cahaya_access/users').child(auth.uid).child('active').val() === true && root.child('cahaya_access/users').child(auth.uid).child('internal').val() === true"
    },
    "guru_kits_materi": {
      ".read": "auth != null && root.child('cahaya_access/users').child(auth.uid).child('active').val() === true && root.child('cahaya_access/users').child(auth.uid).child('internal').val() === true",
      ".write": "auth != null && root.child('cahaya_access/users').child(auth.uid).child('active').val() === true && root.child('cahaya_access/users').child(auth.uid).child('internal').val() === true"
    },
    "buku_tamu": {
      ".read": "auth != null && root.child('cahaya_access/users').child(auth.uid).child('active').val() === true && root.child('cahaya_access/users').child(auth.uid).child('internal').val() === true",
      ".write": "auth != null && root.child('cahaya_access/users').child(auth.uid).child('active').val() === true && root.child('cahaya_access/users').child(auth.uid).child('internal').val() === true"
    },
    "penitipan_barang": {
      ".read": "auth != null && root.child('cahaya_access/users').child(auth.uid).child('active').val() === true && root.child('cahaya_access/users').child(auth.uid).child('internal').val() === true",
      ".write": "auth != null && root.child('cahaya_access/users').child(auth.uid).child('active').val() === true && root.child('cahaya_access/users').child(auth.uid).child('internal').val() === true",
      "index_santri": {
        "$studentKey": {
          ".read": "auth != null && root.child('cahaya_access/wali').child(auth.uid).child('active').val() === true && root.child('cahaya_access/wali').child(auth.uid).child('students').child($studentKey).child('active').val() === true",
          ".write": false
        }
      },
      "$unit": {
        "$month": {
          "$recordId": {
            ".read": "auth != null && data.child('santriId').isString() && root.child('cahaya_access/wali').child(auth.uid).child('active').val() === true && root.child('cahaya_access/wali').child(auth.uid).child('students').child(data.child('santriId').val()).child('active').val() === true",
            ".write": false
          }
        }
      }
    }
  }
}
