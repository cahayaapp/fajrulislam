rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Preserve the existing access policy for collections outside this competition.
    match /{collection}/{rest=**} {
      allow read, write: if !(collection in ['usrah_bersih_202611', 'psb_applications', 'psb_announcements', 'psb_reviews', 'psb_updates', 'psb_receipts']);
    }
    // PSB on Spark: owner-only applications; published updates separate from private review.
    function psbStaff() {
      return request.auth != null && request.auth.uid == 'gGuAzKpiIcNfOlh1YmCivnuIKZl1'
        && request.auth.token.get('psbStaff', false) == true;
    }
    function psbOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    function psbRegistered() { return request.auth != null && exists(/databases/$(database)/documents/psb_applications/$(request.auth.uid)); }
    function text(v, max) { return v is string && v.size() <= max; }
    function psbRegistration(v) { return v is map && v.keys().hasOnly(["studentName","birthPlace","birthDate","nisn","studentNik","address","parentPhone","school","lastEducation","level","tpa","weight","height","diseases","studentCondition","familyStatus","familyCardNumber","fatherName","fatherNik","fatherEducation","fatherJob","fatherIncome","motherName","motherNik","motherEducation","motherJob","motherIncome","parentName"]) && text(v.get('studentName',''),2000)
      && text(v.get('birthPlace',''),2000)
      && text(v.get('birthDate',''),2000)
      && text(v.get('nisn',''),2000)
      && text(v.get('studentNik',''),2000)
      && text(v.get('address',''),600)
      && text(v.get('parentPhone',''),2000)
      && text(v.get('school',''),2000)
      && text(v.get('lastEducation',''),2000)
      && text(v.get('level',''),2000)
      && text(v.get('tpa',''),2000)
      && text(v.get('weight',''),2000)
      && text(v.get('height',''),2000)
      && v.get('diseases',[]) is list && v.get('diseases',[]).size() <= 9 && v.get('diseases',[]).hasOnly(["Magh/Asam Lambung","Penyakit Kulit (Scabies/Panu/Kurap/Gatal-Gatal)","Gigi Berlubang","Migrain","Alergi","Asma/Sesak Nafas/Infeksi Saluran Pernafasan","Amandel","Tipes","Tidak ada"])
      && text(v.get('studentCondition',''),2000)
      && text(v.get('familyStatus',''),2000)
      && text(v.get('familyCardNumber',''),2000)
      && text(v.get('fatherName',''),2000)
      && text(v.get('fatherNik',''),2000)
      && text(v.get('fatherEducation',''),2000)
      && text(v.get('fatherJob',''),2000)
      && text(v.get('fatherIncome',''),2000)
      && text(v.get('motherName',''),2000)
      && text(v.get('motherNik',''),2000)
      && text(v.get('motherEducation',''),2000)
      && text(v.get('motherJob',''),2000)
      && text(v.get('motherIncome',''),2000)
      && text(v.get('parentName',''),2000); }
    function psbWali(v) { return v is map && v.keys().hasOnly(["namaWali","namaAnak","waWali","penyakit","pelanggaran","motivasiWali","keuangan","hadir","sikap","agree","motivation","readiness","support"]) && text(v.get('namaWali',''),2000)
      && text(v.get('namaAnak',''),2000)
      && text(v.get('waWali',''),2000)
      && text(v.get('penyakit',''),2000)
      && text(v.get('pelanggaran',''),2000)
      && text(v.get('motivasiWali',''),2000)
      && text(v.get('keuangan',''),2000)
      && text(v.get('hadir',''),2000)
      && text(v.get('sikap',''),2000)
      && v.get('agree',[]) is list && v.get('agree',[]).size() <= 1 && v.get('agree',[]).hasOnly(["on"]); }
    function psbSantri(v) { return v is map && v.keys().hasOnly(["nama","sekolah","wa","skalaTekad","pendorong","shalat","ngaji","responEjek","pernahBully","sukaPondok","takutPondok","pelanggaranList","kelebihan","motivation","readiness","support"]) && text(v.get('nama',''),2000)
      && text(v.get('sekolah',''),2000)
      && text(v.get('wa',''),2000)
      && text(v.get('skalaTekad',''),2000)
      && text(v.get('pendorong',''),2000)
      && text(v.get('shalat',''),2000)
      && text(v.get('ngaji',''),2000)
      && text(v.get('responEjek',''),2000)
      && text(v.get('pernahBully',''),2000)
      && text(v.get('sukaPondok',''),2000)
      && text(v.get('takutPondok',''),2000)
      && v.get('pelanggaranList',[]) is list && v.get('pelanggaranList',[]).size() <= 6 && v.get('pelanggaranList',[]).hasOnly(["Merokok","Pacaran","Kabur","Begadang","Bully","Bersih"])
      && text(v.get('kelebihan',''),2000); }
    function psbUnchanged(d, key) { return request.method == 'update' && d.get(key,{}) == resource.data.get(key,{}); }
    function psbNameOnly(d, key, name) { return request.method == 'update' && key in resource.data && d[key].diff(resource.data[key]).affectedKeys().hasOnly([name]) && text(d[key].get(name,''),120); }
    function psbValid(d) {
      return d.keys().hasOnly(['uid','email','phone','status','createdAt','updatedAt','contentVersion','registration','waliAssessment','santriAssessment','submittedAt','profile','receiptName'])
        && d.status in ['DRAFT','SUBMITTED'] && d.updatedAt == request.time
        && (!('registration' in d) || psbUnchanged(d,'registration') || psbNameOnly(d,'registration','studentName') || psbRegistration(d.registration)) && (!('waliAssessment' in d) || psbUnchanged(d,'waliAssessment') || psbNameOnly(d,'waliAssessment','namaAnak') || psbWali(d.waliAssessment)) && (!('santriAssessment' in d) || psbUnchanged(d,'santriAssessment') || psbNameOnly(d,'santriAssessment','nama') || psbSantri(d.santriAssessment))
        && text(d.get('receiptName',''),200)
        && d.get('profile',{}) is map && d.get('profile',{}).keys().hasOnly(['studentName']) && text(d.get('profile',{}).get('studentName',''),120);
    }
    function completeregistration(v){return v.get('studentName','').size() > 0
      && v.get('birthPlace','').size() > 0
      && v.get('birthDate','').size() > 0
      && v.get('nisn','').size() > 0
      && v.get('studentNik','').size() > 0
      && v.get('address','').size() > 0
      && v.get('parentPhone','').size() > 0
      && v.get('school','').size() > 0
      && v.get('lastEducation','').size() > 0
      && v.get('lastEducation','') in ["SD/MI","SMP/MTS","SMA/MA"]
      && v.get('level','').size() > 0
      && v.get('level','') in ["SMP","SMA"]
      && v.get('tpa','').size() > 0
      && v.get('weight','').size() > 0
      && v.get('height','').size() > 0
      && v.get('diseases',[]).size() > 0
      && v.get('diseases',[]).hasOnly(["Magh/Asam Lambung","Penyakit Kulit (Scabies/Panu/Kurap/Gatal-Gatal)","Gigi Berlubang","Migrain","Alergi","Asma/Sesak Nafas/Infeksi Saluran Pernafasan","Amandel","Tipes","Tidak ada"])
      && v.get('studentCondition','').size() > 0
      && v.get('studentCondition','') in ["Orang Tua Lengkap","Yatim","Piatu","Yatim Piatu"]
      && v.get('familyStatus','').size() > 0
      && v.get('familyStatus','') in ["Anak Kandung","Anak Angkat/Adopsi","Anak Tiri"]
      && v.get('familyCardNumber','').size() > 0
      && v.get('fatherName','').size() > 0
      && v.get('fatherNik','').size() > 0
      && v.get('fatherEducation','').size() > 0
      && v.get('fatherEducation','') in ["SD","SMP","SMA","D3","S1","S2"]
      && v.get('fatherJob','').size() > 0
      && v.get('fatherJob','') in ["Pegawai Negeri Sipil (PNS)","Pegawai Pemerintah dengan Perjanjian Kerja (P3K)","TNI","POLRI","Guru","Dosen","Karyawan Swasta","Pegawai BUMN","Pegawai Honorer","Buruh Harian Lepas","Wiraswasta","Tenaga Kesehatan (Dokter/Perawat)","Pedagang","Nelayan","Petani","Pensiunan","Tidak Bekerja"]
      && v.get('fatherIncome','').size() > 0
      && v.get('fatherIncome','') in ["Tidak Berpenghasilan","Rp. 500.000 – Rp. 1.000.000","Rp. 1.000.000 – Rp. 2.000.000","Rp. 2.000.000 – Rp. 3.000.000","Rp. 3.000.000 – Rp. 4.000.000","Rp. 4.000.000 – Rp. 5.000.000","> Rp. 5.000.000"]
      && v.get('motherName','').size() > 0
      && v.get('motherNik','').size() > 0
      && v.get('motherEducation','').size() > 0
      && v.get('motherEducation','') in ["SD","SMP","SMA","D3","S1","S2"]
      && v.get('motherJob','').size() > 0
      && v.get('motherJob','') in ["Pegawai Negeri Sipil (PNS)","Pegawai Pemerintah dengan Perjanjian Kerja (P3K)","TNI","POLRI","Guru","Dosen","Karyawan Swasta","Pegawai BUMN","Pegawai Honorer","Wiraswasta","Tenaga Kesehatan (Dokter/Perawat/Bidan)","Pedagang","Nelayan","Petani","Ibu Rumah Tangga","Pensiunan"]
      && v.get('motherIncome','').size() > 0
      && v.get('motherIncome','') in ["Tidak Berpenghasilan","Rp. 500.000 – Rp. 1.000.000","Rp. 1.000.000 – Rp. 2.000.000","Rp. 2.000.000 – Rp. 3.000.000","Rp. 3.000.000 – Rp. 4.000.000","Rp. 4.000.000 – Rp. 5.000.000","> Rp. 5.000.000"]
      && v.get('parentName','').size() > 0;}
    function completesantriAssessment(v){return v.get('nama','').size() > 0
      && v.get('sekolah','').size() > 0
      && v.get('wa','').size() > 0
      && v.get('pendorong','') in ["Sendiri","Ortu","Bersama"]
      && v.get('shalat','').size() > 0
      && v.get('shalat','') in ["Lengkap","BolongDikit","SeringBolong"]
      && v.get('ngaji','').size() > 0
      && v.get('ngaji','') in ["TiapHari","Mingguan","Jarang"]
      && v.get('responEjek','').size() > 0
      && v.get('responEjek','') in ["Diam","BalasLisan","BalasFisik"]
      && v.get('pernahBully','') in ["Tidak","Ya"]
      && v.get('sukaPondok','').size() > 0
      && v.get('takutPondok','').size() > 0
      && v.get('pelanggaranList',[]).hasOnly(["Merokok","Pacaran","Kabur","Begadang","Bully","Bersih"])
      && v.get('kelebihan','').size() > 0;}
    function completewaliAssessment(v){return v.get('namaWali','').size() > 0
      && v.get('namaAnak','').size() > 0
      && v.get('waWali','').size() > 0
      && v.get('motivasiWali','').size() > 0
      && v.get('motivasiWali','') in ["VisiMisi","Mandiri","BiayaLokasi"]
      && v.get('keuangan','').size() > 0
      && v.get('keuangan','') in ["Sanggup","ButuhBicara"]
      && v.get('hadir','').size() > 0
      && v.get('hadir','') in ["Ya","Tidak"]
      && v.get('sikap','').size() > 0
      && v.get('sikap','') in ["","Tabayyun","Pasrah","Protes"]
      && v.get('agree',[]).size() > 0
      && v.get('agree',[]).hasOnly(["on"]);}
    match /psb_applications/{uid} {
      allow get: if psbOwner(uid) || psbStaff();
      allow list: if psbStaff() && request.query.limit <= 300;
      allow create: if psbOwner(uid) && psbValid(request.resource.data)
        && request.resource.data.uid == uid && request.resource.data.email == request.auth.token.email
        && request.resource.data.phone.matches('08[0-9]{8,12}') && request.resource.data.createdAt == request.time
        && request.resource.data.contentVersion == 'DUMMY_V1' && request.resource.data.status == 'DRAFT';
      allow update: if psbOwner(uid) && psbValid(request.resource.data)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['submittedAt','status']) || request.resource.data.status == 'DRAFT' || (completeregistration(request.resource.data.get('registration',{})) && completewaliAssessment(request.resource.data.get('waliAssessment',{})) && completesantriAssessment(request.resource.data.get('santriAssessment',{})) && exists(/databases/$(database)/documents/psb_receipts/$(uid))))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registration','waliAssessment','santriAssessment','status','submittedAt','updatedAt','profile','receiptName']);
    }
    match /psb_receipts/{uid} {
      allow get: if psbOwner(uid) || psbStaff();
      allow create, update: if psbOwner(uid) && psbRegistered()
        && request.resource.data.keys().hasOnly(['name','type','size','data','updatedAt'])
        && text(request.resource.data.name,200) && request.resource.data.name.size() > 0
        && request.resource.data.type in ['image/jpeg','image/png','image/webp','application/pdf']
        && request.resource.data.size is int && request.resource.data.size > 0 && request.resource.data.size <= 614400
        && text(request.resource.data.data,819200) && request.resource.data.data.size() > 0
        && request.resource.data.updatedAt == request.time;
    }
    match /psb_reviews/{uid} {
      allow read: if psbStaff();
      allow create, update: if psbStaff() && exists(/databases/$(database)/documents/psb_applications/$(uid))
        && request.resource.data.keys().hasOnly(['interview','result']);
    }
    match /psb_updates/{uid} {
      allow get: if psbOwner(uid) || psbStaff();
      allow create, update: if psbStaff() && exists(/databases/$(database)/documents/psb_applications/$(uid))
        && request.resource.data.keys().hasOnly(['schedule','result'])
        && (request.resource.data.get('result',null) == null || request.resource.data.result.published == true);
    }
    match /psb_announcements/{id} {
      allow read: if psbRegistered() || psbStaff();
      allow create: if psbStaff() && request.resource.data.keys().hasOnly(['title','body','createdAt','createdBy'])
        && text(request.resource.data.title,2000) && request.resource.data.title.size() > 0
        && text(request.resource.data.body,2000) && request.resource.data.body.size() > 0
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
    }
    function anggota() {
      return request.auth != null && request.auth.token.email in [
        'multazam@cahayaapp.id', 'bennyarizona@cahayaapp.id', 'donisetiawan@cahayaapp.id', 'dandi@cahayaapp.id', 'zaky@cahayaapp.id'
      ];
    }
    function ranking() {
      return /databases/$(database)/documents/usrah_bersih_202611/rekap;
    }
    match /usrah_bersih_202611/rekap/sesi/{id} {
      function skor(n) { return n is int && n >= 0 && n <= 100; }
      function sah() {
        let d = request.resource.data;
        let lokal = d.waktu + duration.value(7, 'h');
        return d.keys().hasOnly(['kriteria','nilai','waktu','penilai','akun','disimpan'])
          && lokal.year() == 2026 && lokal.month() == 11 && lokal.day() >= 11 && lokal.day() <= 21
          && d.waktu <= request.time && d.disimpan == request.time
          && request.time < timestamp.date(2026,11,22) - duration.value(7,'h')
          && d.akun == request.auth.token.email
          && d.kriteria in ['kamar','piket','kompak']
          && d.penilai in ['Abah Multazam Zakaria','Abi Dandy',"Mu'allim Zaky"]
          && id.matches('2026-11-(1[1-9]|2[01])-' + d.kriteria)
          && int(id.split('-')[2]) == lokal.day()
          && d.nilai is list && d.nilai.size() == 6
          && skor(d.nilai[0]) && skor(d.nilai[1]) && skor(d.nilai[2])
          && skor(d.nilai[3]) && skor(d.nilai[4]) && skor(d.nilai[5]);
      }
      allow read: if anggota();
      allow create: if anggota() && sah()
        && getAfter(ranking()).data.lastSession == id;
    }
    match /usrah_bersih_202611/rekap {
      allow get: if true;
      function validUpdate() {
        let next = request.resource.data;
        let path = /databases/$(database)/documents/usrah_bersih_202611/rekap/sesi/$(next.lastSession);
        let scores = getAfter(path).data.nilai;
        let prev = exists(ranking()) ? resource.data : {'sessions':0,'sums':[0,0,0,0,0,0]};
        return !exists(path) && next.keys().hasOnly(['sessions','sums','lastSession'])
          && next.sessions == prev.sessions + 1 && next.sessions <= 33
          && next.sums == [prev.sums[0]+scores[0], prev.sums[1]+scores[1],
                           prev.sums[2]+scores[2], prev.sums[3]+scores[3],
                           prev.sums[4]+scores[4], prev.sums[5]+scores[5]];
      }
      allow create, update: if anggota() && validUpdate();
    }
  }
}
